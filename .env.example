# Copier en .env (jamais commité) et remplir
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Générer avec: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=

# Mot de passe du super admin créé par le seed
SEED_ADMIN_PASSWORD=

# Upload des logos et photos côté serveur (T09). Compte gratuit sur cloudinary.com :
# tableau de bord (Dashboard) > "Product Environment Credentials" > Cloud name, API Key, API Secret.
# Le secret ne doit jamais être exposé au navigateur (pas de préfixe NEXT_PUBLIC_).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
