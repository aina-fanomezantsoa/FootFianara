generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ASSISTANT
}

enum MatchStatus {
  SCHEDULED
  PLAYED
  POSTPONED
  FORFEIT
}

enum EventType {
  GOAL
  OWN_GOAL
  YELLOW
  RED
  SUB
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String
  name         String
  role         Role
  matches      Match[]
}

model Season {
  id          Int          @id @default(autoincrement())
  name        String
  startDate   DateTime
  endDate     DateTime
  clubs       ClubSeason[]
  matches     Match[]
  suspensions Suspension[]
}

model Division {
  id      Int          @id @default(autoincrement())
  name    String       @unique
  level   Int          @unique
  clubs   ClubSeason[]
  matches Match[]
}

model Club {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  shortName    String
  logoUrl      String?
  colors       String?
  foundedYear  Int?
  district     String?
  president    String?
  coach        String?
  teamPhotoUrl String?
  phone        String?
  facebookUrl  String?
  seasons      ClubSeason[]
}

model ClubSeason {
  id          Int      @id @default(autoincrement())
  season      Season   @relation(fields: [seasonId], references: [id])
  seasonId    Int
  division    Division @relation(fields: [divisionId], references: [id])
  divisionId  Int
  club        Club     @relation(fields: [clubId], references: [id])
  clubId      Int
  squad       Squad[]
  homeMatches Match[]  @relation("Home")
  awayMatches Match[]  @relation("Away")

  @@unique([seasonId, clubId])
}

model Player {
  id          Int          @id @default(autoincrement())
  firstName   String
  lastName    String
  photoUrl    String?
  position    String?
  birthDate   DateTime?
  heightCm    Int?
  strongFoot  String?
  nationality String?
  squads      Squad[]
  lineups     Lineup[]
  events      MatchEvent[] @relation("EventPlayer")
  assists     MatchEvent[] @relation("EventAssist")
  subsIn      MatchEvent[] @relation("EventPlayerIn")
  suspensions Suspension[]
}

model Squad {
  id           Int        @id @default(autoincrement())
  clubSeason   ClubSeason @relation(fields: [clubSeasonId], references: [id])
  clubSeasonId Int
  player       Player     @relation(fields: [playerId], references: [id])
  playerId     Int
  shirtNumber  Int

  @@unique([clubSeasonId, playerId])
  @@unique([clubSeasonId, shirtNumber])
}

model Stadium {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  city    String?
  matches Match[]
}

model Match {
  id               Int          @id @default(autoincrement())
  season           Season       @relation(fields: [seasonId], references: [id])
  seasonId         Int
  division         Division     @relation(fields: [divisionId], references: [id])
  divisionId       Int
  matchday         Int
  homeClubSeason   ClubSeason   @relation("Home", fields: [homeClubSeasonId], references: [id])
  homeClubSeasonId Int
  awayClubSeason   ClubSeason   @relation("Away", fields: [awayClubSeasonId], references: [id])
  awayClubSeasonId Int
  stadium          Stadium?     @relation(fields: [stadiumId], references: [id])
  stadiumId        Int?
  kickoffAt        DateTime?
  status           MatchStatus  @default(SCHEDULED)
  homeGoals        Int?
  awayGoals        Int?
  updatedAt        DateTime     @updatedAt
  updatedBy        User?        @relation(fields: [updatedById], references: [id])
  updatedById      Int?
  events           MatchEvent[]
  lineup           Lineup[]
  suspensions      Suspension[]

  @@unique([divisionId, homeClubSeasonId, awayClubSeasonId])
}

model MatchEvent {
  id             Int       @id @default(autoincrement())
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId        Int
  type           EventType
  minute         Int
  player         Player    @relation("EventPlayer", fields: [playerId], references: [id])
  playerId       Int
  assistPlayer   Player?   @relation("EventAssist", fields: [assistPlayerId], references: [id])
  assistPlayerId Int?
  playerIn       Player?   @relation("EventPlayerIn", fields: [playerInId], references: [id])
  playerInId     Int?
}

model Lineup {
  id        Int     @id @default(autoincrement())
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   Int
  player    Player  @relation(fields: [playerId], references: [id])
  playerId  Int
  isStarter Boolean

  @@unique([matchId, playerId])
}

model Suspension {
  id            Int     @id @default(autoincrement())
  player        Player  @relation(fields: [playerId], references: [id])
  playerId      Int
  matchesTotal  Int
  matchesServed Int     @default(0)
  reason        String
  // matchId renseigné = suspension automatique (BR-32, match déclencheur) ; matchId null = saisie manuelle (BR-31). seasonId = saison concernée.
  season        Season? @relation(fields: [seasonId], references: [id])
  seasonId      Int?
  match         Match?  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId       Int?
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  imageUrl    String?
  publishedAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
